# 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다)
LOG_LEVEL=INFO

# 로컬 Docker Postgres(README "로컬 개발 환경" 4번). 개인 Render Postgres 를 쓰면 대시보드의 External Database URL 로 바꾼다
#   예) DATABASE_URL=postgresql://<사용자>:<비밀번호>@<호스트>/<DB 이름>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot

# 토큰 서명 키(32바이트 이상). 아래는 로컬 전용 값 — 배포에는 반드시 새로 만든 값을 넣는다
#   새 값 만들기: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_EXPIRE_MINUTES=60
# 로컬은 http 라 false. 배포(https)에서는 넣지 않는다(기본값 true)
COOKIE_SECURE=false
# 프론트를 다른 주소에 따로 배포할 때만. 예) CORS_ORIGINS=https://fe.onrender.com
CORS_ORIGINS=

# AI 호출은 서버에서만 수행한다. 키가 비어 있으면 채팅은 503, 인증·조회는 계속 동작한다.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3-30b-a3b-instruct-2507
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024
CHAT_CONTEXT_PAIRS=5
CHAT_MAX_QUESTION_LENGTH=5000
# 선택: OpenRouter 앱 표시용 헤더. 비어 있으면 보내지 않는다.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
